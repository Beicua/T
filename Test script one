local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/NICKISBAD/Nick-s-Modded-KAVO-Lib/main/Nick'sModdedKavoLib.lua"))()

local Window = Library.CreateLib("Control Player UI", "DarkTheme")
local Tab = Window:NewTab("Main")
local Section = Tab:NewSection("Control")

local Players = game:GetService("Players")
local selectedPlayer = nil

local function GetPlayersList()
    local list = {}

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Players.LocalPlayer then
            table.insert(list, p.Name)
        end
    end

    return list
end

-- Dropdown
local Dropdown = Section:NewDropdown(
    "เลือกผู้เล่น",
    "เลือกเป้าหมาย",
    GetPlayersList(),
    function(option)
        selectedPlayer = option
        print("เลือก:", selectedPlayer)
    end
)

-- ปุ่มรีชื่อ
Section:NewButton("รีชื่อผู้เล่น", "รีเฟรชรายชื่อ", function()
    Dropdown:Refresh(GetPlayersList())
end)

-- ฟังก์ชันใช้สกิล
local function UseSkill(skill, titanType)
    if not selectedPlayer then
        warn("ยังไม่ได้เลือกผู้เล่น")
        return
    end

    local target = Players:FindFirstChild(selectedPlayer)

    if target and target.Character then
        local args = {
            skill,
            target.Character,
            titanType,
            target.Name,
        }

        game:GetService("ReplicatedStorage").Main:FireServer(unpack(args))
    end
end

