local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local selectedPlayer = nil

local Window = Fluent:CreateWindow({
    Title = "Control Ui",
    SubTitle = "Ymir UI",
    TabWidth = 160,
    Size = UDim2.fromOffset(500, 380),
    Acrylic = true,
    Theme = "Aqua",
    MinimizeKey = Enum.KeyCode.x
})

local Tabs = {
    Main = Window:AddTab({ Title = "Choose User" }),
    Skills = Window:AddTab({ Title = "Skills" })
}

local function GetPlayersList()
    local list = {"qoexjsz"}

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Players.LocalPlayer then
            table.insert(list, p.Name)
        end
    end

    return list
end

local Dropdown = Tabs.Main:AddDropdown("PlayerSelect", {
    Title = "เลือกผู้เล่น",
    Values = GetPlayersList(),
    Multi = false,
    Default = 1
})

Dropdown:OnChanged(function(Value)
    selectedPlayer = Value
    print("เลือก:", selectedPlayer)
end)

Tabs.Main:AddButton({
    Title = "รีชื่อผู้เล่น",
    Callback = function()
        Dropdown:SetValues(GetPlayersList())

        Fluent:Notify({
            Title = "System",
            Content = "รีเฟรชรายชื่อแล้ว",
            Duration = 3
        })
    end
})

local function UseSkill(skill, titanType)

    if not selectedPlayer then
        warn("ยังไม่ได้เลือกผู้เล่น")
        return
    end

    if selectedPlayer == "qoexjsz" then

        for _, target in pairs(Players:GetPlayers()) do

            if target ~= Players.LocalPlayer and target.Character then

                local args = {
                    skill,
                    target.Character,
                    titanType,
                    target.Name,
                }

                game:GetService("ReplicatedStorage").Main:FireServer(unpack(args))
            end
        end

        return
    end

    local target = Players:FindFirstChild(selectedPlayer)

    if target and target.Character then

        local args = {
            skill,
            target.Character,
            titanType,
            target.Name,
        }

        game:GetService("ReplicatedStorage").Main:FireServer(unpack(args))
    end
end

