-- ======================
-- 👁️ HIGHLIGHT PLAYERS
-- ======================

local highlightEnabled = false
local highlights = {}

local function GetValue(character, name)
    local obj = character:FindFirstChild(name)

    if obj and obj:IsA("ValueBase") then
        return obj.Value
    end

    local attr = character:GetAttribute(name)
    if attr ~= nil then
        return attr
    end

    return 0
end

local function GetRoot(plr)
    local character = workspace:FindFirstChild(plr.Name)
    if not character then return nil end

    return character:FindFirstChild("HumanoidRootPart")
end

local function CreatePlayerESP(plr)
    local character = workspace:FindFirstChild(plr.Name)
    if not character then return end

    local head = character:FindFirstChild("Head")
    if not head then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerHighlight"
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PlayerInfo"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 180, 0, 85)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.Name = "Info"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.Parent = billboard

    highlights[plr.Name] = {
        Highlight = highlight,
        Billboard = billboard,
        Label = label
    }
end

local function RemovePlayerESP(plr)
    local data = highlights[plr.Name]

    if data then
        if data.Highlight then
            data.Highlight:Destroy()
        end

        if data.Billboard then
            data.Billboard:Destroy()
        end

        highlights[plr.Name] = nil
    end
end

Tab:CreateToggle({
    Name = "Highlight Players",
    CurrentValue = false,

    Callback = function(v)
        highlightEnabled = v

        if not v then
            for _, plr in ipairs(Players:GetPlayers()) do
                RemovePlayerESP(plr)
            end

            table.clear(highlights)
            return
        end

        -- 🔄 LOOP เช็กตลอด
        task.spawn(function()
            while highlightEnabled do

                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then

                        local character = workspace:FindFirstChild(plr.Name)

                        -- สร้าง ESP ถ้ายังไม่มี
                        if character and not highlights[plr.Name] then
                            CreatePlayerESP(plr)
                        end

                        local data = highlights[plr.Name]

                        if data and character then
                            local myRoot = GetRoot(LocalPlayer)
                            local targetRoot = GetRoot(plr)

                            if myRoot and targetRoot then

                                -- 📏 ระยะห่าง
                                local distance =
                                    (myRoot.Position - targetRoot.Position).Magnitude

                                -- 📊 ค่า
                                local ultimate =
                                    GetValue(character, "Ultimate")

                                local blockStam =
                                    GetValue(character, "BlockStam")

                                -- 📝 อัปเดตข้อความ
                                data.Label.Text =
                                    plr.Name ..
                                    "\nUltimate: " .. tostring(ultimate) ..
                                    "\nBlockStam: " .. tostring(blockStam) ..
                                    "\nDistance: " ..
                                    math.floor(distance) .. " studs"
                            end
                        end
                    end
                end

                -- 🔄 เช็กใหม่ทุก 0.1 วินาที
                task.wait(0.1)
            end
        end)
    end,
})

