-- 👣 FOOTSTEP
-- ======================

local foot = "All"
local footLoop = false

local function FireFoot(name, side)
    pcall(function()
        game:GetService("ReplicatedStorage").Remotes.RunEffect:FireServer(
            "Global",
            "Footstep",
            workspace[name],
            side,
            Enum.Material.Mud
        )
    end)
end

Tab:CreateDropdown({
   Name = "Footstep Player",
   Options = GetPlayersList(),
   CurrentOption = {"All"},
   Callback = function(v)
        foot = v[1]
   end,
})

Tab:CreateToggle({
   Name = "Footstep Loop",
   CurrentValue = false,
   Callback = function(v)
        footLoop = v

        if v then
            task.spawn(function()
                while footLoop do

                    if foot == "Yourself" then
                        FireFoot(LocalPlayer.Name, "Left")
                        FireFoot(LocalPlayer.Name, "Right")

                    elseif foot == "All" then
                        for _, p in pairs(Players:GetPlayers()) do
                            FireFoot(p.Name, "Left")
