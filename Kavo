local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Control UI",
   LoadingTitle = "Loading...",
   LoadingSubtitle = "Tester script",
   ConfigurationSaving = { Enabled = false },
   Theme = "Blue"
})

local Tab = Window:CreateTab("Main", 4483362458)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ======================
-- 🧠 PLAYER LIST
-- ======================

local function GetPlayersList()
    local list = {"All", "Yourself"}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

-- ======================
-- 🔥 BLOCKSTART
-- ======================

local selectedPlayer = "All"
local blockLoop = false

local function FireBlock(name)
    pcall(function()
        workspace[name].RemoteEvent:FireServer("BlockStart")
    end)
end

local dropdown = Tab:CreateDropdown({
   Name = "Block Player",
   Options = GetPlayersList(),
   CurrentOption = {"All"},
   Callback = function(v)
        selectedPlayer = v[1]
   end,
})

Tab:CreateButton({
   Name = "Refresh Names",
   Callback = function()
        dropdown:Refresh(GetPlayersList())
   end,
})

Tab:CreateToggle({
   Name = "BlockStart Loop",
   CurrentValue = false,
   Callback = function(v)
        blockLoop = v

        if v then
            task.spawn(function()
                while blockLoop do

                    if selectedPlayer == "Yourself" then
                        FireBlock(LocalPlayer.Name)

                    elseif selectedPlayer == "All" then
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer then
                                FireBlock(p.Name)
                            end
                        end
                    else
                        FireBlock(selectedPlayer)
                    end

                    task.wait(0.05)
                end
            end)
        end
   end,
})

