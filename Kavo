-- ======================
-- 🛡️ AUTO NEAR BLOCK
-- ======================

local nearBlock = false
local nearDistance = 70
local activePlayers = {}

local function GetRoot(plr)
    local char = workspace:FindFirstChild(plr.Name)
    if not char then return nil end

    return char:FindFirstChild("HumanoidRootPart")
end

local function IsNear(plr)
    local myRoot = GetRoot(LocalPlayer)
    local targetRoot = GetRoot(plr)

    if not myRoot or not targetRoot then
        return false
    end

    return (myRoot.Position - targetRoot.Position).Magnitude <= nearDistance
end

local function BlockStart(plr)
    local char = workspace:FindFirstChild(plr.Name)
    if not char then return end

    local remote = char:FindFirstChild("RemoteEvent")
    if not remote then return end

    remote:FireServer("BlockStart")
end

local function BlockStop(plr)
    local char = workspace:FindFirstChild(plr.Name)
    if not char then return end

    local remote = char:FindFirstChild("RemoteEvent")
    if not remote then return end

    remote:FireServer("BlockStop")
end

Tab:CreateToggle({
    Name = "Auto Near Block dis70",
    CurrentValue = false,

    Callback = function(v)
        nearBlock = v

        if not v then
            for _, plr in pairs(activePlayers) do
                BlockStop(plr)
            end

            table.clear(activePlayers)
            return
        end

        task.spawn(function()
            while nearBlock do

                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then

                        if IsNear(p) then
                            -- อยู่ในระยะ 70 → ยิง Start ซ้ำเรื่อย ๆ
                            activePlayers[p.Name] = p
                            BlockStart(p)

                        elseif activePlayers[p.Name] then
                            -- พ้น 70 → Stop
                            activePlayers[p.Name] = nil
                            BlockStop(p)

                            Rayfield:Notify({
                                Title = "Auto Near Block",
                                Content = "Block stopped: " .. p.Name,
                                Duration = 2
                            })
                        end

                    end
                end

                task.wait(0.1)
            end
        end)
    end,
})
